# Supabase. Only the two NEXT_PUBLIC_ values ever reach the browser; SUPABASE_SECRET_KEY is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SECRET_KEY=<secret-key>

# Postgres. The app uses the transaction pooler (6543, prepare: false); drizzle-kit migrations use the session pooler (5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Eval key for `bun run agent:run` on Claude models only. Use a separate Anthropic workspace so evals never share a rate-limit budget with users.
ANTHROPIC_EVAL_API_KEY=<anthropic-eval-key>

# Vercel Sandbox for the preview, for local dev and `bun run agent:run`. Never set these on a Vercel deployment.
# A deployment enables the sandbox only with BETTERLOOK_SANDBOX=on, which uses the deployment's own OIDC token. Production leaves it unset.
VERCEL_TOKEN=<vercel-token>
VERCEL_TEAM_ID=<team-id>
VERCEL_PROJECT_ID=<project-id>

# Langfuse tracing. Leave empty to disable tracing.
LANGFUSE_PUBLIC_KEY=<langfuse-public-key>
LANGFUSE_SECRET_KEY=<langfuse-secret-key>
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: eval key for `bun run agent:run` on GPT models. Use a separate OpenAI project.
# OPENAI_EVAL_API_KEY=<openai-eval-key>
