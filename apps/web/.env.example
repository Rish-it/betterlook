# Langfuse tracing. Leave empty to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Vercel Sandbox for the preview, for local dev and `bun run agent:run`. Never set these on a Vercel deployment.
# A deployment enables the sandbox only with BETTERLOOK_SANDBOX=on, which uses the deployment's own OIDC token. Production leaves it unset.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Eval key for `bun run agent:run` only. Use a separate OpenAI project so evals never share a rate-limit budget with users.
OPENAI_EVAL_API_KEY=

# Eval key for `bun run agent:run --model claude-*` only. Use a separate Anthropic workspace so evals never share a rate-limit budget with users.
ANTHROPIC_EVAL_API_KEY=
