# Langfuse tracing. Leave empty to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Vercel Sandbox for the preview. Either a token triple, or VERCEL_OIDC_TOKEN from `vercel env pull`.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Eval key for `bun run agent:run` only. Use a separate OpenAI project so evals never share a rate-limit budget with users.
OPENAI_EVAL_API_KEY=

# Eval key for `bun run agent:run --model claude-*` only. Use a separate Anthropic workspace so evals never share a rate-limit budget with users.
ANTHROPIC_EVAL_API_KEY=
